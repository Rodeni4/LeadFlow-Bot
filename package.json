{
  "name": "leadflow-bot",
  "version": "1.0.0",
  "description": "LeadFlow Bot desktop app",
  "main": "dist/main/electron.js",
  "scripts": {
    "dev": "concurrently -n MAIN,RENDERER,ELECTRON -c blue,green,magenta \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 file:dist/main/electron.js && cross-env NODE_ENV=development electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "start": "electron ."
  },
  "keywords": [
    "electron",
    "telegram",
    "google-sheets",
    "leads"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "googleapis": "^163.0.0",
    "node-telegram-bot-api": "^0.66.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/node-telegram-bot-api": "^0.64.9",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.1",
    "wait-on": "^9.0.3"
  }
}
